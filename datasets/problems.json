{
  "version": "0.1.0.dev0",
  "sizes": {"s": 10, "m": 100, "l": 1000},
  "size_rule": "s and m scale the problem's data to about 10 ms and 100 ms of work per cell on the reference machine; l is m's data with reps = 10 (the cell feeds work's output back into work ten times), which keeps memory bounded.",
  "problems": [
    {"id": "matmul", "legacy": "C1", "title": "numpy matmul", "bound": "cpu", "domain": "micro", "libs": ["numpy"],
     "params": {"s": {"n": 1180}, "m": {"n": 2540}, "l": {"n": 2540, "reps": 10}}},
    {"id": "rfft", "legacy": "C2", "title": "numpy rfft", "bound": "cpu", "domain": "micro", "libs": ["numpy"],
     "params": {"s": {"n": 925000}, "m": {"n": 9000000}, "l": {"n": 9000000, "reps": 10}}},
    {"id": "pyloop", "legacy": "C3", "title": "pure-Python loop", "bound": "cpu", "domain": "micro", "libs": [],
     "params": {"s": {"n": 150000}, "m": {"n": 1500000}, "l": {"n": 1500000, "reps": 10}}},
    {"id": "disk_big", "legacy": "D1", "title": "disk: one large file, fsync", "bound": "disk", "domain": "micro", "libs": [],
     "params": {"s": {"mb": 7}, "m": {"mb": 70}, "l": {"mb": 70, "reps": 10}}},
    {"id": "disk_small", "legacy": "D2", "title": "disk: many 4 KB files", "bound": "disk", "domain": "micro", "libs": [],
     "params": {"s": {"files": 80}, "m": {"files": 630}, "l": {"files": 630, "reps": 10}}},
    {"id": "http_sync", "legacy": "N1", "title": "network: sequential GETs", "bound": "net", "domain": "micro", "libs": [],
     "params": {"s": {"requests": 3}, "m": {"requests": 21}, "l": {"requests": 21, "reps": 10}}},
    {"id": "http_async", "legacy": "N2", "title": "network: concurrent GETs, top-level await", "bound": "net", "domain": "micro", "libs": [], "async": true,
     "params": {"s": {"requests": 5, "parallel": 4}, "m": {"requests": 80, "parallel": 4}, "l": {"requests": 80, "parallel": 4, "reps": 10}}},
    {"id": "pd_groupby", "title": "pandas groupby-aggregate", "bound": "cpu", "domain": "datasci", "libs": ["numpy", "pandas"],
     "params": {"s": {"rows": 490000, "groups": 1000}, "m": {"rows": 7700000, "groups": 1000}, "l": {"rows": 7700000, "groups": 1000, "reps": 10}}},
    {"id": "pd_join", "title": "pandas merge and aggregate", "bound": "cpu", "domain": "datasci", "libs": ["numpy", "pandas"],
     "params": {"s": {"rows": 500000, "customers": 50000}, "m": {"rows": 5500000, "customers": 550000}, "l": {"rows": 5500000, "customers": 550000, "reps": 10}}},
    {"id": "pd_rolling", "title": "pandas rolling windows and resample", "bound": "cpu", "domain": "datasci", "libs": ["numpy", "pandas"],
     "params": {"s": {"rows": 490000, "window": 30}, "m": {"rows": 4400000, "window": 30}, "l": {"rows": 4400000, "window": 30, "reps": 10}}},
    {"id": "features", "title": "feature engineering and correlation", "bound": "cpu", "domain": "datasci", "libs": ["numpy", "pandas"],
     "params": {"s": {"rows": 10500, "cols": 10}, "m": {"rows": 108000, "cols": 10}, "l": {"rows": 108000, "cols": 10, "reps": 10}}},
    {"id": "sk_logreg", "title": "scikit-learn logistic regression fit", "bound": "cpu", "domain": "ml", "libs": ["numpy", "scikit-learn"],
     "params": {"s": {"rows": 15000, "cols": 20, "iterations": 200}, "m": {"rows": 180000, "cols": 20, "iterations": 200}, "l": {"rows": 180000, "cols": 20, "iterations": 200, "reps": 10}}},
    {"id": "sk_kmeans", "title": "scikit-learn k-means", "bound": "cpu", "domain": "ml", "libs": ["numpy", "scikit-learn"],
     "params": {"s": {"rows": 33000, "clusters": 8, "iterations": 10}, "m": {"rows": 500000, "clusters": 8, "iterations": 10}, "l": {"rows": 500000, "clusters": 8, "iterations": 10, "reps": 10}}},
    {"id": "sk_forest", "title": "scikit-learn random forest fit", "bound": "cpu", "domain": "ml", "libs": ["numpy", "scikit-learn"],
     "params": {"s": {"rows": 1000, "trees": 9}, "m": {"rows": 5000, "trees": 19}, "l": {"rows": 5000, "trees": 19, "reps": 10}}},
    {"id": "io_csv", "title": "CSV write and read", "bound": "disk", "domain": "datasci", "libs": ["numpy", "pandas"],
     "params": {"s": {"rows": 2200}, "m": {"rows": 22700}, "l": {"rows": 22700, "reps": 10}}},
    {"id": "io_parquet", "title": "Parquet write and read", "bound": "disk", "domain": "datasci", "libs": ["numpy", "pandas", "pyarrow"],
     "params": {"s": {"rows": 25000}, "m": {"rows": 580000}, "l": {"rows": 580000, "reps": 10}}},
    {"id": "sqlite", "title": "SQLite in-memory load, join, group", "bound": "cpu", "domain": "datasci", "libs": [],
     "params": {"s": {"rows": 17000}, "m": {"rows": 164000}, "l": {"rows": 164000, "reps": 10}}},
    {"id": "text_regex", "title": "regex tokenising and counting", "bound": "cpu", "domain": "text", "libs": [],
     "params": {"s": {"documents": 1000}, "m": {"documents": 10000}, "l": {"documents": 10000, "reps": 10}}},
    {"id": "text_json", "title": "JSON encode, decode, aggregate", "bound": "cpu", "domain": "text", "libs": [],
     "params": {"s": {"records": 1350}, "m": {"records": 13300}, "l": {"records": 13300, "reps": 10}}},
    {"id": "image", "title": "Pillow rotate, blur, resize", "bound": "cpu", "domain": "viz", "libs": ["numpy", "pillow"],
     "params": {"s": {"side": 720, "blur": 2}, "m": {"side": 2260, "blur": 2}, "l": {"side": 2260, "blur": 2, "reps": 10}}},
    {"id": "figure", "title": "matplotlib figure to PNG", "bound": "cpu", "domain": "viz", "libs": ["numpy", "matplotlib"],
     "params": {"s": {"points": 500, "dpi": 30}, "m": {"points": 200000, "dpi": 200}, "l": {"points": 200000, "dpi": 200, "reps": 10}}}
  ]
}
